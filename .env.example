# Application
APP_NAME="IT IS FINISHED REVIVAL OUTREACH"
NEXTJS_ENV="production"

# Seeded Super Admin (required for seed; force password change on first login)
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional seeded approved member for local security tests
SEED_MEMBER_NAME="Test Member"
SEED_MEMBER_EMAIL="member@example.com"
SEED_MEMBER_PASSWORD="Member123!"

# Optional transactional email (Resend). Without this, reset links are logged
# to the server console in development so the flow can still be tested.
RESEND_API_KEY=""
EMAIL_FROM="IT IS FINISHED <no-reply@example.com>"

# Public site URL used in emails (no trailing slash)
APP_URL="http://localhost:3000"

# Daily devotional AI generation (Worker secret in production)
OPENAI_API_KEY=""
