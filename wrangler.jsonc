{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itisfinished-outreach",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itisfinished-db",
      "database_id": "223f7960-c712-4750-be2d-5b232fe037ed",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "itisfinished-media",
      "preview_bucket_name": "itisfinished-media-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "NEXTJS_ENV": "production",
    "APP_NAME": "IT IS FINISHED REVIVAL OUTREACH INTERNATIONAL",
    "APP_URL": "https://itisfinished-outreach.jimonemmanuel.workers.dev",
    "EMAIL_FROM": "IT IS FINISHED <noreply@REPLACE-WITH-VERIFIED-DOMAIN>"
  }
}
